<%- include('partials/header') %>

<section class="page-head ebook-head reveal">
  <span class="eyebrow"><%= t('nav_ebooks') %></span>
  <h1><%= t('ebooks_title') %></h1>
  <p class="muted"><%= t('ebooks_sub') %></p>
  <p class="no-refund" role="note"><%= t('no_refund_note') %> <a href="/conditions"><%= t('nav_terms') %></a></p>
  <div class="publisher-card" style="margin-top:18px">
    <img src="/img/levent-logo.jpg" alt="Les Éditions LeVent" width="84" height="84">
    <div>
      <strong>Les Éditions LeVent</strong><br>
      <a href="mailto:<%= publisherEmail %>"><%= publisherEmail %></a>
    </div>
  </div>
</section>

<% if (ebooks.length === 0) { %>
  <p class="muted"><%= t('empty_catalogue') %></p>
<% } else { %>
  <div class="grid">
    <% ebooks.forEach(function(p){ %>
      <%- include('partials/product_card', { p: p }) %>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
