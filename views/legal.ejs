<%- include('partials/header') %>

<article class="legal">
  <h1><%= t(doc === 'privacy' ? 'privacy_title' : 'ip_title') %></h1>
  <p class="lead"><%= t(doc === 'privacy' ? 'privacy_intro' : 'ip_intro') %></p>
  <% (t(doc === 'privacy' ? 'privacy_sections' : 'ip_sections') || []).forEach(function(s){ %>
    <section>
      <h2><%= s.h %></h2>
      <p><%= s.p %></p>
    </section>
  <% }) %>
</article>

<%- include('partials/footer') %>
