<%- include('../partials/header') %>

<section class="page-head">
  <span class="eyebrow">Admin</span>
  <h1>Ventes</h1>
  <p class="muted">Chaque achat sur Payhip, Gumroad ou Shopify arrive ici en direct et te prévient par e-mail, Telegram, WhatsApp et SMS
    (selon les canaux configurés dans Notifications). Amazon KDP n'envoie pas d'alerte : ses ventes restent visibles dans le tableau de bord KDP.</p>
  <div class="dash-actions">
    <a class="btn btn-small btn-ghost" href="/admin">Tableau de bord</a>
    <a class="btn btn-small btn-ghost" href="/admin/notifications">Notifications</a>
    <form method="post" action="/admin/ventes/test" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-small" type="submit">Envoyer une vente de test</button>
    </form>
  </div>
</section>

<% if (saved) { %><p class="alert alert-ok">Réglages de vérification enregistrés.</p><% } %>
<% if (tested) { %><p class="alert alert-ok">Vente de test enregistrée : tu dois avoir reçu l'alerte sur tes canaux configurés.</p><% } %>

<section class="dash-panel">
  <h2>Vérification des ventes</h2>
  <p class="muted small">Chaque vente reçue est vérifiée auprès de sa plateforme : une fausse vente envoyée par un inconnu est rejetée.</p>
  <ul class="mini-list">
    <li>Payhip : <strong><%= verif.payhip ? '✔ clé API enregistrée' : '✖ clé API Payhip à saisir ci-dessous (sinon les ventes Payhip sont refusées)' %></strong></li>
    <li>Gumroad : contrôle du seller_id <code><%= verif.gumroadSeller %></code><%= verif.gumroadToken ? " + confirmation par l'API ✔" : " (jeton d'accès facultatif pour une vérification renforcée)" %></li>
    <li>Shopify : <strong><%= verif.shopify ? '✔ secret de signature enregistré' : '✖ secret de signature à saisir (affiché par Shopify sous la liste des webhooks)' %></strong></li>
  </ul>
  <form method="post" action="/admin/ventes/verification" class="form form-wide">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-row">
      <label>Clé API Payhip (Payhip → Paramètres → Promoteur)
        <input type="password" name="payhip_api_key" value="<%= verif.payhip ? '••••••••' : '' %>" autocomplete="new-password"></label>
      <label>Secret de signature Shopify
        <input type="password" name="shopify_webhook_secret" value="<%= verif.shopify ? '••••••••' : '' %>" autocomplete="new-password"></label>
    </div>
    <div class="form-row">
      <label>Gumroad seller_id
        <input type="text" name="gumroad_seller_id" value="<%= verif.gumroadSeller %>"></label>
      <label>Jeton d'accès Gumroad (facultatif)
        <input type="password" name="gumroad_access_token" value="<%= verif.gumroadToken ? '••••••••' : '' %>" autocomplete="new-password"></label>
    </div>
    <div><button class="btn" type="submit">Enregistrer</button></div>
  </form>
</section>

<section class="dash-panel">
  <h2>Adresses à mettre dans tes boutiques (une seule fois)</h2>
  <p class="muted small">Ces adresses ne contiennent aucun secret.</p>
  <div class="cred-group">
    <h3>Payhip</h3>
    <p class="small">Payhip → <strong>Settings → Developer → Webhooks</strong> → ajoute l'URL ci-dessous, événement <em>paid</em> (et <em>refunded</em>).</p>
    <input type="text" readonly value="<%= urls.payhip %>" onclick="this.select()">
  </div>
  <div class="cred-group">
    <h3>Gumroad</h3>
    <p class="small">Gumroad → <strong>Settings → Advanced → Ping</strong> (« Ping endpoint ») → colle l'URL ci-dessous et enregistre.</p>
    <input type="text" readonly value="<%= urls.gumroad %>" onclick="this.select()">
  </div>
  <div class="cred-group">
    <h3>Shopify</h3>
    <p class="small">Shopify → <strong>Paramètres → Notifications → Webhooks</strong> → Créer un webhook : événement <em>Création de commande</em>, format JSON, URL ci-dessous.</p>
    <input type="text" readonly value="<%= urls.shopify %>" onclick="this.select()">
  </div>
</section>

<section class="dash-panel">
  <h2><%= sales.length %> vente(s) reçue(s) — total <%= total.toFixed(2) %> $</h2>
  <% if (!sales.length) { %>
    <p class="muted">Aucune vente reçue pour l'instant. Une fois les adresses ci-dessus branchées, chaque achat apparaîtra ici.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="admin-table">
        <thead><tr><th>Date (UTC)</th><th>Plateforme</th><th>Produit</th><th>Montant</th><th>Client</th><th>Type</th></tr></thead>
        <tbody>
          <% sales.forEach(function (s) { %>
            <tr class="<%= s.kind === 'sale' ? '' : 'row-off' %>">
              <td class="nowrap small"><%= s.at %></td>
              <td><%= s.platform %></td>
              <td><%= s.product %></td>
              <td class="nowrap"><%= Number(s.amount).toFixed(2) %> <%= s.currency %></td>
              <td class="small"><%= s.buyer %></td>
              <td><span class="tag <%= s.kind === 'sale' ? 'tag-update' : 'tag-off' %>"><%= { sale: 'vente', refund: 'remboursement', test: 'test' }[s.kind] || s.kind %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
