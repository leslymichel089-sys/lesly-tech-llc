<%- include('../partials/header') %>

<section class="page-head">
  <h1>Configuration IA</h1>
  <p class="muted">Bascule automatique : le site essaie les fournisseurs <strong>dans cet ordre</strong> (DeepSeek d'abord) et passe au suivant
    en cas d'échec. Seuls ceux qui ont une clé sont utilisés. Un fournisseur qui échoue 3 fois de suite est mis en pause 10 minutes.</p>
  <div class="dash-actions">
    <a class="btn btn-small btn-ghost" href="/admin">Tableau de bord</a>
  </div>
</section>

<% if (saved) { %><p class="alert alert-ok">Configuration IA enregistrée.</p><% } %>
<div id="ai-test-result" class="alert" style="display:none" aria-live="polite"></div>
<div id="ai-models" class="dash-panel" style="display:none">
  <h2 id="ai-models-title">Modèles disponibles</h2>
  <p class="muted small">Clique sur un modèle pour le mettre dans le champ « Modèle », puis enregistre.</p>
  <div id="ai-models-list" class="model-list"></div>
</div>

<section class="dash-panel">
  <h2>État de la chaîne de secours</h2>
  <div class="table-wrap">
    <table class="admin-table">
      <thead><tr><th>#</th><th>Fournisseur</th><th>Modèle</th><th>État</th><th>Dernière erreur</th></tr></thead>
      <tbody>
        <% aiStatus.forEach(function (s) { %>
          <tr class="<%= s.configured ? '' : 'row-off' %>">
            <td><%= s.priority %></td>
            <td><strong><%= s.name %></strong></td>
            <td class="small"><%= s.model %></td>
            <td><span class="tag <%= s.state === 'ok' ? 'tag-update' : (s.state === 'erreur' || s.state === 'pause') ? 'tag-off' : '' %>">
              <%= { absent: 'pas de clé', pause: 'en pause', erreur: 'erreur', ok: 'OK', inconnu: 'pas encore utilisé' }[s.state] %></span></td>
            <td class="muted small"><%= s.lastError %><% if (s.hint) { %><br><strong style="color:var(--ink)">→ <%= s.hint %></strong><% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="dash-panel">
  <h2>Clés des fournisseurs</h2>
  <form method="post" action="/admin/ai/credentials" class="form form-wide">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% aiProviders.forEach(function (p, i) { %>
      <fieldset class="cred-group">
        <legend><%= p.name %> — priorité <%= i + 1 %></legend>
        <p class="muted small">Clé : <%= p.help %></p>
        <div class="form-row">
          <label>Clé API <%- include('cred_badge', { src: aiCredSrc[p.id + '_key'], t: t }) %>
            <input type="password" name="<%= p.id %>_key" value="<%= aiCreds[p.id + '_key'] %>" autocomplete="new-password"></label>
          <label>URL de base <%- include('cred_badge', { src: aiCredSrc[p.id + '_base_url'], t: t }) %>
            <input type="text" name="<%= p.id %>_base_url" value="<%= aiCreds[p.id + '_base_url'] %>" placeholder="<%= p.base %>"></label>
          <label>Modèle <%- include('cred_badge', { src: aiCredSrc[p.id + '_model'], t: t }) %>
            <input type="text" name="<%= p.id %>_model" value="<%= aiCreds[p.id + '_model'] %>" placeholder="<%= p.model %>"></label>
        </div>
        <div class="form-actions">
          <button type="button" class="btn btn-small btn-ghost ai-test" data-provider="<%= p.id %>" data-csrf="<%= csrfToken %>">Tester <%= p.name %></button>
          <button type="button" class="btn btn-small btn-ghost ai-test-all" data-provider="<%= p.id %>" data-csrf="<%= csrfToken %>">Tester tous les modèles</button>
          <% if (aiCredSrc[p.id + '_key'] === 'admin') { %>
            <label class="check-row small"><input type="checkbox" name="<%= p.id %>_key_clear" value="1"> Effacer la clé</label>
          <% } %>
        </div>
      </fieldset>
    <% }) %>
    <p class="muted small">Les clés restent dans la base du site et ne sont jamais réaffichées en clair. Laisse un champ vide pour garder la valeur actuelle.</p>
    <div><button class="btn" type="submit">Enregistrer la configuration IA</button></div>
  </form>
</section>

<script>
(function () {
  function field(provider, name) {
    var el = document.querySelector('[name="' + provider + '_' + name + '"]');
    return el ? el.value : '';
  }
  function showResult(result, isOk) {
    var box = document.getElementById('ai-test-result');
    box.style.display = 'block';
    box.className = 'alert ' + (isOk ? 'alert-ok' : 'alert-error');
    box.textContent = result;
    box.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  // Liste complète des modèles, cliquables : remplit le champ « Modèle » du fournisseur.
  function showModels(provider, models, current) {
    var box = document.getElementById('ai-models'), list = document.getElementById('ai-models-list');
    list.innerHTML = '';
    if (!models.length) { box.style.display = 'none'; return; }
    document.getElementById('ai-models-title').textContent = models.length + ' modèle(s) disponible(s) chez ' + provider;
    models.slice().sort().forEach(function (m) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'model-pill' + (m === current ? ' is-current' : ''); b.textContent = m;
      b.addEventListener('click', function () {
        var input = document.querySelector('[name="' + provider + '_model"]');
        input.value = m;
        input.focus(); input.scrollIntoView({ behavior: 'smooth', block: 'center' });
        list.querySelectorAll('.model-pill').forEach(function (x) { x.classList.toggle('is-current', x === b); });
      });
      list.appendChild(b);
    });
    box.style.display = 'block';
  }

  document.querySelectorAll('.ai-test').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var provider = btn.getAttribute('data-provider');
      showResult('Test en cours pour ' + provider + '…', true);
      var payload = { provider: provider, _csrf: btn.getAttribute('data-csrf') };
      payload[provider + '_key'] = field(provider, 'key');
      payload[provider + '_base_url'] = field(provider, 'base_url');
      payload[provider + '_model'] = field(provider, 'model');
      try {
        var res = await fetch('/admin/ai/test', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        var data = await res.json();
        var r = data.result || {};
        var msg = provider + ' : ' + (r.ok ? 'fonctionne ✔' : 'échec ✖') + '.';
        if (r.latencyMs != null) msg += ' ' + r.latencyMs + ' ms.';
        if (r.chatOk && r.sample) msg += ' Réponse : « ' + r.sample + ' ».';
        if (r.error) msg += ' Détail : ' + r.error + '.';
        if (r.hint) msg += '\n→ ' + r.hint;
        if (r.models && r.models.length && !r.modelKnown) {
          msg += r.ok
            ? ' ℹ « ' + r.model + ' » fonctionne, mais n\'apparaît plus dans la liste officielle (ancien nom) : tu peux garder ce modèle ou en choisir un ci-dessous.'
            : ' ⚠ Le modèle « ' + r.model + ' » n\'est pas proposé par ce fournisseur : choisis-en un dans la liste ci-dessous, puis enregistre.';
        }
        showResult(msg, r.ok);
        showModels(provider, r.models || [], r.model);
      } catch (e) {
        showResult('Erreur réseau : ' + e.message, false);
      }
    });
  });

  // « Tester tous les modèles » : essaie chaque modèle de discussion et montre lesquels répondent vraiment.
  document.querySelectorAll('.ai-test-all').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      var provider = btn.getAttribute('data-provider');
      showResult('Test de tous les modèles de ' + provider + ' en cours… (jusqu\'à 1 minute)', true);
      btn.disabled = true;
      var payload = { provider: provider, _csrf: btn.getAttribute('data-csrf') };
      payload[provider + '_key'] = field(provider, 'key');
      payload[provider + '_base_url'] = field(provider, 'base_url');
      try {
        var res = await fetch('/admin/ai/test-models', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        var d = await res.json();
        var results = d.results || [];
        var good = results.filter(function (r) { return r.ok; });
        if (!results.length) {
          showResult(provider + ' : impossible de lister les modèles. ' + (d.error || '') + (d.hint ? '\n→ ' + d.hint : ''), false);
          return;
        }
        var msg = provider + ' : ' + good.length + ' modèle(s) sur ' + results.length + ' répondent.';
        if (good.length) msg += ' Clique sur un modèle ✔ ci-dessous pour le choisir, puis enregistre.';
        else {
          // Même cause pour tous ? On l'affiche une fois, clairement.
          var hints = results.map(function (r) { return r.hint; }).filter(Boolean);
          if (hints.length) msg += '\n→ ' + hints[0];
        }
        showResult(msg, good.length > 0);
        var box = document.getElementById('ai-models'), list = document.getElementById('ai-models-list');
        document.getElementById('ai-models-title').textContent = 'Résultat par modèle — ' + provider;
        list.innerHTML = '';
        results.forEach(function (r) {
          var row = document.createElement('div');
          row.className = 'model-row' + (r.ok ? ' ok' : ' ko');
          var b = document.createElement('button');
          b.type = 'button'; b.className = 'model-pill'; b.textContent = (r.ok ? '✔ ' : '✖ ') + r.model;
          b.disabled = !r.ok;
          b.addEventListener('click', function () {
            var input = document.querySelector('[name="' + provider + '_model"]');
            input.value = r.model; input.focus(); input.scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
          var info = document.createElement('span');
          info.className = 'muted small';
          info.textContent = r.ok ? (r.ms + ' ms') : ((r.hint || r.error || '').slice(0, 220));
          row.appendChild(b); row.appendChild(info);
          list.appendChild(row);
        });
        box.style.display = 'block';
      } catch (e) {
        showResult('Erreur réseau : ' + e.message, false);
      } finally { btn.disabled = false; }
    });
  });
})();
</script>

<%- include('../partials/footer') %>
