<%- include('../partials/header') %>

<section class="page-head">
  <h1>Newsletter</h1>
  <p class="muted"><%= count %> abonné(s).</p>
  <div class="dash-actions">
    <a class="btn btn-small btn-ghost" href="/admin">Tableau de bord</a>
    <a class="btn btn-small" href="/admin/newsletter.csv">Exporter CSV</a>
  </div>
</section>

<section class="dash-panel">
  <% if (subscribers.length === 0) { %>
    <p class="muted">Aucun abonné pour le moment.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="admin-table">
        <thead><tr><th>Email</th><th>Date</th></tr></thead>
        <tbody>
          <% subscribers.forEach(function(s){ %>
            <tr><td><%= s.email %></td><td class="muted small"><%= s.created_at %></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>