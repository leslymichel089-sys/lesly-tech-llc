<%- include('../partials/header') %>

<section class="page-head">
  <span class="eyebrow">Admin</span>
  <h1>Ajouter / Enlever</h1>
  <p class="muted">Clique sur « Ajouter des fichiers » : l'explorateur Windows s'ouvre, choisis un ou plusieurs fichiers, ils sont publiés aussitôt.
    Tu peux aussi les glisser-déposer n'importe où sur le site. Pour retirer une publication : <strong>Masquer</strong> la cache au public (récupérable),
    <strong>Enlever</strong> la supprime définitivement.</p>
  <div class="dash-actions">
    <a class="btn btn-small btn-ghost" href="/admin">Tableau de bord</a>
    <a class="btn btn-small btn-ghost" href="/admin/add">Ajouter par lien</a>
  </div>
</section>

<section class="dash-panel files-drop">
  <button type="button" class="btn btn-big" data-files-pick>＋ Ajouter des fichiers</button>
  <p class="muted small">Images, vidéos (80 Mo max.), audio, PDF, EPUB, Word, Excel, PowerPoint, ZIP — jusqu'à 20 fichiers à la fois.</p>
</section>

<section class="dash-panel">
  <h2><%= products.length %> publication(s)</h2>
  <div class="files-list">
    <% products.forEach(function (p) { %>
      <div class="files-row<%= p.active ? '' : ' is-hidden' %>">
        <a class="files-thumb" href="/produit/<%= p.id %>" target="_blank">
          <% if (p.image) { %><img src="<%= p.image %>" alt="" loading="lazy">
          <% } else { %><span><%= p.type === 'video' ? '▶' : p.type === 'ebook' ? '📕' : '📄' %></span><% } %>
        </a>
        <div class="files-info">
          <strong><%= p.title %></strong>
          <span class="muted small"><%= t('type_' + (['app', 'ebook', 'video', 'image'].indexOf(p.type) >= 0 ? p.type : 'autre')) %>
            · <%= p.active ? 'Visible' : 'Masquée' %><%= p.links.length ? ' · ' + p.links.length + ' lien(s)' : '' %></span>
        </div>
        <div class="files-actions">
          <button type="button" class="btn btn-small btn-ghost" data-toggle-visible="<%= p.id %>"><%= p.active ? '👁 Masquer' : '👁 Afficher' %></button>
          <a class="btn btn-small btn-ghost" href="/admin/products/<%= p.id %>/edit">Modifier</a>
          <button type="button" class="btn btn-small btn-danger" data-remove="<%= p.id %>" data-title="<%= p.title %>">🗑 Enlever</button>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<%- include('../partials/footer') %>
