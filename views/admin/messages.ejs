<%- include('../partials/header') %>

<section class="page-head">
  <h1>Messages de contact</h1>
  <p class="muted"><%= count %> message(s) reçu(s).</p>
  <div class="dash-actions">
    <a class="btn btn-small btn-ghost" href="/admin">Tableau de bord</a>
  </div>
</section>

<section class="dash-panel">
  <% if (messages.length === 0) { %>
    <p class="muted">Aucun message pour le moment.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="admin-table">
        <thead><tr><th>Date</th><th>Nom</th><th>Email</th><th>Message</th></tr></thead>
        <tbody>
          <% messages.forEach(function(m){ %>
            <tr>
              <td class="muted small"><%= m.created_at %></td>
              <td><%= m.name %></td>
              <td><a href="mailto:<%= m.email %>"><%= m.email %></a></td>
              <td style="white-space: pre-wrap"><%= m.message %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
