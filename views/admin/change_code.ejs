<%- include('../partials/header') %>

<section class="page-head">
  <h1>Changer le code admin</h1>
  <div class="dash-actions">
    <a class="btn btn-small btn-ghost" href="/admin">Tableau de bord</a>
  </div>
</section>

<% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
<% if (changed) { %><p class="alert alert-ok">Code admin modifié.</p><% } %>

<section class="dash-panel">
  <form method="post" action="/admin/change-code" class="form form-wide">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-row">
      <label>Code actuel
        <input type="password" name="current_code" autocomplete="current-password"></label>
      <label>Nouveau code, 4 chiffres
        <input type="password" name="code" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="new-password"></label>
      <label>Confirmer le nouveau code
        <input type="password" name="confirm" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="new-password"></label>
    </div>
    <div class="form-actions">
      <button class="btn" type="submit">Modifier le code</button>
    </div>
  </form>
</section>

<%- include('../partials/footer') %>
