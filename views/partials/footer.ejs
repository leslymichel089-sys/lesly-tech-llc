</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="logo" href="/">Lesly Tech <span>LLC</span></a>
        <p><%= t('footer_tagline') %></p>
        <p class="small">Les Éditions LeVent · <a href="mailto:<%= publisherEmail %>" style="color:inherit"><%= publisherEmail %></a></p>
      </div>
      <div class="footer-col">
        <h4><%= t('footer_explore') %></h4>
        <a href="/"><%= t('nav_home') %></a>
        <a href="/catalogue"><%= t('nav_catalogue') %></a>
        <a href="/ebooks"><%= t('nav_ebooks') %></a>
      </div>
      <div class="footer-col">
        <h4><%= t('footer_legal') %></h4>
        <a href="/confidentialite"><%= t('nav_privacy') %></a>
        <a href="/propriete-intellectuelle"><%= t('nav_ip') %></a>
        <a href="/conditions"><%= t('nav_terms') %></a>
        <a href="/contact"><%= t('nav_contact') %></a>
        <a href="/admin">🔒 Admin</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span><%= t('footer_rights') %></span>
      <span class="lang-links">
        <% langs.forEach(function(l){ %>
          <a href="/lang/<%= l %>" class="<%= l === lang ? 'active' : '' %>"><%= l.toUpperCase() %></a>
        <% }) %>
      </span>
    </div>
  </div>
</footer>

<% if (isAdmin) { %>
<div class="admin-fab" id="admin-fab">
  <button type="button" class="admin-fab-main" data-files-pick title="Ouvre l'explorateur Windows pour ajouter des fichiers">＋ Ajouter / − Enlever</button>
  <a class="admin-fab-side" href="/admin/fichiers" title="Gérer : masquer ou enlever des publications">Gérer</a>
</div>
<input type="file" id="files-input" multiple hidden
       accept=".png,.jpg,.jpeg,.webp,.gif,.avif,.mp4,.webm,.mov,.mp3,.wav,.m4a,.ogg,.pdf,.epub,.docx,.doc,.xlsx,.pptx,.txt,.zip">
<div class="upload-overlay" id="upload-overlay" hidden>
  <div class="upload-box">
    <strong id="upload-title">Envoi en cours…</strong>
    <div class="upload-bar"><span id="upload-bar"></span></div>
    <p class="muted small" id="upload-detail"></p>
  </div>
</div>
<% } %>
<% if (chatEnabled && !String(currentPath).startsWith('/admin')) { %>
<div class="chat-widget" id="chat-widget" data-csrf="<%= csrfToken %>" data-lang="<%= lang %>" data-copy="<%= t('chat_copy') %>" data-copied="<%= t('chat_copied') %>">
  <button type="button" class="chat-toggle" id="chat-toggle" aria-expanded="false" aria-controls="chat-panel">💬 <span><%= t('chat_open') %></span></button>
  <div class="chat-panel" id="chat-panel" role="dialog" aria-label="<%= t('chat_title') %>" hidden>
    <div class="chat-head">
      <img src="/img/levent-logo.jpg" alt="" width="36" height="36">
      <div><strong><%= t('chat_title') %></strong><br><span><%= t('chat_sub') %></span></div>
      <% if (locals.sitePromo && locals.leadPopup !== undefined) { %><button type="button" class="chat-head-btn chat-offer" data-lead-open title="<%= t('chat_offer') %>"><%= t('chat_offer') %></button><% } %>
      <button type="button" class="chat-head-btn" id="chat-copy-all" title="<%= t('chat_copy_all') %>" aria-label="<%= t('chat_copy_all') %>">⧉</button>
      <button type="button" class="chat-close" id="chat-close" aria-label="Fermer">✕</button>
    </div>
    <div class="chat-body">
      <div class="chat-log" id="chat-log" aria-live="polite">
        <div class="chat-msg bot"><%= t('chat_hello') %></div>
      </div>
      <button type="button" class="chat-down" id="chat-down" title="<%= t('chat_down') %>" aria-label="<%= t('chat_down') %>" hidden>↓</button>
    </div>
    <div class="chat-files" id="chat-files" hidden></div>
    <form class="chat-form" id="chat-form">
      <button type="button" class="chat-clip" id="chat-clip" title="<%= t('chat_attach') %> — <%= t('chat_files_hint') %>" aria-label="<%= t('chat_attach') %>">📎</button>
      <input type="file" id="chat-file" multiple hidden accept=".png,.jpg,.jpeg,.webp,.gif,.pdf,.doc,.docx,.txt,.md,.csv,.json">
      <textarea id="chat-input" rows="1" maxlength="800" placeholder="<%= t('chat_placeholder') %>" aria-label="<%= t('chat_placeholder') %>"></textarea>
      <button type="submit" class="btn btn-small"><%= t('chat_send') %></button>
    </form>
    <p class="chat-note" data-typing="<%= t('chat_typing') %>"><%= t('chat_note') %></p>
  </div>
</div>
<% } %>
<% if (googleClientId && !visitor && !String(currentPath).startsWith('/admin')) { %>
<div class="auth-modal" id="auth-modal" hidden data-client-id="<%= googleClientId %>" data-csrf="<%= csrfToken %>" data-error="<%= t('auth_error') %>">
  <div class="auth-box" role="dialog" aria-modal="true" aria-labelledby="auth-title">
    <button type="button" class="auth-x" data-auth-anon aria-label="Fermer">✕</button>
    <img src="/img/levent-logo.jpg" alt="" width="64" height="64" class="auth-logo">
    <h2 id="auth-title"><%= t('auth_title') %></h2>
    <p class="muted"><%= t('auth_text') %></p>
    <label class="check-row auth-consent"><input type="checkbox" id="auth-consent"> <span><%= t('auth_consent') %></span></label>
    <div id="google-btn" class="google-btn"></div>
    <button type="button" class="btn btn-ghost auth-anon" data-auth-anon><%= t('auth_anonymous') %></button>
    <p class="muted small"><a href="/confidentialite"><%= t('auth_privacy') %></a></p>
  </div>
</div>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<% } %>
<% if (!String(currentPath).startsWith('/admin')) { %>
<div class="site-notice" id="site-notice" role="region" aria-label="Information" hidden>
  <p><%= t('notice_text') %> <a href="/confidentialite"><%= t('notice_more') %></a></p>
  <button type="button" class="btn btn-small" id="site-notice-ok"><%= t('notice_ok') %></button>
</div>
<% } %>
<% if (locals.sitePromo && !String(currentPath).startsWith('/admin')) { %>
<div class="lead-modal" id="lead-modal" hidden data-csrf="<%= csrfToken %>" data-auto="<%= locals.leadPopup ? '1' : '0' %>" data-delay="<%= locals.leadPopupDelay || 20 %>" data-promo="<%= locals.sitePromo.id %>">
  <div class="lead-box" role="dialog" aria-modal="true" aria-labelledby="lead-title">
    <button type="button" class="auth-x" data-lead-close aria-label="Fermer">✕</button>
    <h2 id="lead-title"><%= t('lead_title') %></h2>
    <div id="lead-form-wrap">
      <p><%= t('lead_text').replace('{label}', promoLabel(locals.sitePromo)) %></p>
      <form id="lead-form" novalidate>
        <input type="email" id="lead-email" required autocomplete="email" placeholder="<%= t('lead_email') %>" aria-label="<%= t('lead_email') %>">
        <label class="check-row auth-consent"><input type="checkbox" id="lead-consent"> <span><%= t('lead_consent') %></span></label>
        <p class="lead-err" id="lead-err" hidden><%= t('lead_err') %></p>
        <button type="submit" class="btn" style="width:100%"><%= t('lead_submit') %></button>
      </form>
      <button type="button" class="btn btn-ghost auth-anon" data-lead-close><%= t('lead_no') %></button>
      <p class="muted small"><a href="/confidentialite"><%= t('auth_privacy') %></a></p>
    </div>
    <div id="lead-done" hidden>
      <p><%= t('lead_ok') %></p>
      <p class="lead-code" id="lead-code"></p>
      <p class="muted small" id="lead-mail" hidden><%= t('lead_ok_mail') %></p>
      <a class="btn" href="/ebooks" style="width:100%"><%= t('promo_see') %> →</a>
    </div>
  </div>
</div>
<% } %>
<script src="/js/main.js"></script>
</body>
</html>
