</main>

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="logo" href="/">Lesly Tech <span>LLC</span></a>
        <p><%= t('footer_tagline') %></p>
        <p class="small">Les Éditions LeVent · <a href="mailto:<%= publisherEmail %>" style="color:inherit"><%= publisherEmail %></a></p>
      </div>
      <div class="footer-col">
        <h4><%= t('footer_explore') %></h4>
        <a href="/"><%= t('nav_home') %></a>
        <a href="/catalogue"><%= t('nav_catalogue') %></a>
        <a href="/ebooks"><%= t('nav_ebooks') %></a>
      </div>
      <div class="footer-col">
        <h4><%= t('footer_legal') %></h4>
        <a href="/confidentialite"><%= t('nav_privacy') %></a>
        <a href="/propriete-intellectuelle"><%= t('nav_ip') %></a>
        <a href="/conditions"><%= t('nav_terms') %></a>
        <a href="/contact"><%= t('nav_contact') %></a>
        <a href="/admin">🔒 Admin</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span><%= t('footer_rights') %></span>
      <span class="lang-links">
        <% langs.forEach(function(l){ %>
          <a href="/lang/<%= l %>" class="<%= l === lang ? 'active' : '' %>"><%= l.toUpperCase() %></a>
        <% }) %>
      </span>
    </div>
  </div>
</footer>

<% if (isAdmin) { %>
<div class="admin-fab" id="admin-fab">
  <button type="button" class="admin-fab-main" data-files-pick title="Ouvre l'explorateur Windows pour ajouter des fichiers">＋ Ajouter / − Enlever</button>
  <a class="admin-fab-side" href="/admin/fichiers" title="Gérer : masquer ou enlever des publications">Gérer</a>
</div>
<input type="file" id="files-input" multiple hidden
       accept=".png,.jpg,.jpeg,.webp,.gif,.avif,.mp4,.webm,.mov,.mp3,.wav,.m4a,.ogg,.pdf,.epub,.docx,.doc,.xlsx,.pptx,.txt,.zip">
<div class="upload-overlay" id="upload-overlay" hidden>
  <div class="upload-box">
    <strong id="upload-title">Envoi en cours…</strong>
    <div class="upload-bar"><span id="upload-bar"></span></div>
    <p class="muted small" id="upload-detail"></p>
  </div>
</div>
<% } %>
<% if (chatEnabled && !String(currentPath).startsWith('/admin')) { %>
<div class="chat-widget" id="chat-widget" data-csrf="<%= csrfToken %>" data-lang="<%= lang %>">
  <button type="button" class="chat-toggle" id="chat-toggle" aria-expanded="false" aria-controls="chat-panel">💬 <span><%= t('chat_open') %></span></button>
  <div class="chat-panel" id="chat-panel" role="dialog" aria-label="<%= t('chat_title') %>" hidden>
    <div class="chat-head">
      <img src="/img/levent-logo.jpg" alt="" width="36" height="36">
      <div><strong><%= t('chat_title') %></strong><br><span><%= t('chat_sub') %></span></div>
      <button type="button" class="chat-close" id="chat-close" aria-label="Fermer">✕</button>
    </div>
    <div class="chat-log" id="chat-log" aria-live="polite">
      <div class="chat-msg bot"><%= t('chat_hello') %></div>
    </div>
    <form class="chat-form" id="chat-form">
      <input type="text" id="chat-input" maxlength="800" autocomplete="off" placeholder="<%= t('chat_placeholder') %>" aria-label="<%= t('chat_placeholder') %>">
      <button type="submit" class="btn btn-small"><%= t('chat_send') %></button>
    </form>
    <p class="chat-note" data-typing="<%= t('chat_typing') %>"><%= t('chat_note') %></p>
  </div>
</div>
<% } %>
<script src="/js/main.js"></script>
</body>
</html>
