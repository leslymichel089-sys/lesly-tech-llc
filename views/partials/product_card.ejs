<%
// Carte produit : image réelle (couverture), repli élégant si absente.
var mediaClass = p.type === 'ebook' ? 'card-media-book' : (p.type === 'app' ? 'card-media-app' : '');
var typeKey = 'type_' + (p.type === 'app' ? 'app' : p.type === 'ebook' ? 'ebook' : 'autre');
%>
<article class="card reveal">
  <a class="card-media <%= mediaClass %>" href="/produit/<%= p.id %>" aria-label="<%= p.title %>">
    <% if (p.image) { %>
      <img src="<%= p.image %>" alt="<%= p.title %>" loading="lazy">
    <% } else { %>
      <div class="card-ph" aria-hidden="true"><span><%= p.title.charAt(0).toUpperCase() %></span></div>
    <% } %>
  </a>
  <div class="card-body">
    <div class="card-tags">
      <span class="tag tag-type"><%= t(typeKey) %></span>
      <% if (p.version) { %><span class="tag"><%= t('badge_version') %> <%= p.version %></span><% } %>
      <% if (p.update_available) { %><span class="tag tag-update"><%= t('badge_update') %></span><% } %>
      <% if (!p.active) { %><span class="tag tag-off"><%= t('badge_inactive') %></span><% } %>
    </div>
    <h3 class="card-title"><a href="/produit/<%= p.id %>"><%= p.title %></a></h3>
    <p class="card-desc"><%= descFor(p, lang) %></p>
    <a class="btn btn-small" href="/produit/<%= p.id %>"><%= t('cta_details') %> →</a>
  </div>
</article>
