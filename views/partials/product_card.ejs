<%
// Carte produit : image réelle (couverture), repli élégant si absente.
var mediaClass = p.type === 'ebook' ? 'card-media-book' : (p.type === 'app' ? 'card-media-app' : (p.type === 'video' ? 'card-media-video' : ''));
var typeKey = 'type_' + (['app', 'ebook', 'video', 'image'].indexOf(p.type) >= 0 ? p.type : 'autre');
var isVideo = p.type === 'video';
%>
<article class="card reveal<%= p.active ? '' : ' card-hidden' %>">
  <% if (isAdmin) { %>
    <div class="card-admin">
      <button type="button" class="card-admin-btn" data-toggle-visible="<%= p.id %>"><%= p.active ? '👁 Masquer' : '👁 Afficher' %></button>
      <button type="button" class="card-admin-btn card-admin-del" data-remove="<%= p.id %>" data-title="<%= p.title %>">🗑 Enlever</button>
    </div>
  <% } %>
  <a class="card-media <%= mediaClass %>" href="/produit/<%= p.id %>" aria-label="<%= p.title %>">
    <% if (p.image) { %>
      <img class="card-bg" src="<%= p.image %>" alt="" aria-hidden="true" loading="lazy">
      <img class="card-img" src="<%= p.image %>" alt="<%= p.title %>" loading="lazy">
      <% if (isVideo || p.media) { %><span class="play-badge" aria-hidden="true">▶</span><% } %>
    <% } else { %>
      <div class="card-ph" aria-hidden="true"><span><%= p.title.charAt(0).toUpperCase() %></span></div>
    <% } %>
  </a>
  <div class="card-body">
    <div class="card-tags">
      <span class="tag tag-type"><%= t(typeKey) %></span>
      <% var cardPromo = locals.promoFor ? promoFor(p.id) : null; %><% if (cardPromo) { %><span class="tag tag-promo"><%= promoLabel(cardPromo) %></span><% } %>
      <% if (p.version) { %><span class="tag"><%= t('badge_version') %> <%= p.version %></span><% } %>
      <% if (p.update_available) { %><span class="tag tag-update"><%= t('badge_update') %></span><% } %>
      <% if (!p.active) { %><span class="tag tag-off"><%= t('badge_inactive') %></span><% } %>
    </div>
    <h3 class="card-title"><a href="/produit/<%= p.id %>"><%= p.title %></a></h3>
    <p class="card-desc"><%= descFor(p, lang) %></p>
    <a class="btn btn-small" href="/produit/<%= p.id %>"><%= t('cta_details') %> →</a>
  </div>
</article>
