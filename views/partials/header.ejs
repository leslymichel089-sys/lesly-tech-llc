<!DOCTYPE html>
<html lang="<%= lang %>" data-theme="clair"<%- String(currentPath).startsWith('/admin') ? ' translate="no" class="notranslate"' : '' %>>
<head>
<meta charset="utf-8">
<% if (String(currentPath).startsWith('/admin')) { %><meta name="google" content="notranslate"><% } %>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="<%= t('home_intro_text').slice(0, 150) %>">
<link rel="canonical" href="<%= siteUrl + currentPath %>">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Lesly Tech LLC">
<meta property="og:title" content="<%= t('meta_title') %>">
<meta property="og:description" content="<%= t('home_intro_text').slice(0, 150) %>">
<meta property="og:url" content="<%= siteUrl + currentPath %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= t('meta_title') %>">
<meta name="twitter:description" content="<%= t('home_intro_text').slice(0, 150) %>">
<title><%= t('meta_title') %></title>
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
<script>
try { var _th = localStorage.getItem('ltl-theme'); if (_th) document.documentElement.setAttribute('data-theme', _th); } catch (e) {}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Lesly Tech LLC",
  "url": "<%= siteUrl %>",
  "email": "<%= contactEmail %>",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "2512 Delaware Pl",
    "addressLocality": "High Point",
    "addressRegion": "NC",
    "postalCode": "27260",
    "addressCountry": "US"
  }
}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
<link rel="stylesheet" href="/css/style.css">
<% if (isAdmin) { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
</head>
<body>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="logo" href="/"><img src="/icon.svg" alt="" width="30" height="30"> Lesly Tech <span>LLC</span></a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle">
    <label for="nav-toggle" class="nav-burger" aria-label="Menu" tabindex="0" role="button">☰</label>
    <nav class="site-nav">
      <a href="/" class="<%= page === 'home' ? 'active' : '' %>"><%= t('nav_home') %></a>
      <a href="/catalogue" class="<%= page === 'catalogue' ? 'active' : '' %>"><%= t('nav_catalogue') %></a>
      <a href="/ebooks" class="<%= page === 'ebooks' ? 'active' : '' %>"><%= t('nav_ebooks') %></a>
      <a href="/services" class="<%= page === 'services' ? 'active' : '' %>"><%= t('nav_services') %></a>
      <a href="/publiez-votre-livre" class="<%= page === 'edition' ? 'active' : '' %>"><%= t('nav_edition') %></a>
      <a href="/contact" class="<%= page === 'contact' ? 'active' : '' %>"><%= t('nav_contact') %></a>
    </nav>
    <div class="header-tools">
      <% if (googleClientId) { %>
        <% if (visitor) { %>
          <span class="visitor-chip">
            <% if (visitor.picture) { %><img src="<%= visitor.picture %>" alt="" width="24" height="24" referrerpolicy="no-referrer"><% } %>
            <span><%= t('auth_hello') %> <%= String(visitor.name || '').split(' ')[0] %></span>
            <button type="button" class="visitor-logout" data-auth-logout data-csrf="<%= csrfToken %>"><%= t('auth_logout') %></button>
          </span>
        <% } else { %>
          <button type="button" class="admin-link login-link" data-auth-open><%= t('auth_login') %></button>
        <% } %>
      <% } %>
      <a class="admin-link<%= isAdmin ? ' is-on' : '' %>" href="/admin" title="<%= isAdmin ? 'Tableau de bord admin' : 'Connexion admin' %>"><%= isAdmin ? '⚙ Admin' : '🔒 Admin' %></a>
      <span class="tool">
        <span class="tool-label"><%= t('lang_label') %></span>
        <span class="lang-links">
          <% langs.forEach(function(l){ %>
            <a href="/lang/<%= l %>" class="<%= l === lang ? 'active' : '' %>"><%= l.toUpperCase() %></a>
          <% }) %>
        </span>
      </span>
      <label class="tool">
        <span class="tool-label"><%= t('theme_label') %></span>
        <select id="theme-select" class="theme-select" aria-label="<%= t('theme_label') %>">
          <option value="clair"><%= t('theme_clair') %></option>
          <option value="ambre"><%= t('theme_ambre') %></option>
          <option value="emeraude"><%= t('theme_emeraude') %></option>
          <option value="nuit"><%= t('theme_nuit') %></option>
          <option value="sombre"><%= t('theme_sombre') %></option>
        </select>
      </label>
    </div>
  </div>
</header>

<% if (locals.sitePromo) { var sp = locals.sitePromo; %>
<div class="promo-bar" role="note">
  <div class="wrap promo-bar-inner">
    <span class="promo-bar-tag"><%= t('promo_badge') %></span>
    <span><strong><%= sp.title %></strong> — <%= promoLabel(sp) %> <%= t('promo_on') %> <%= sp.product_ids.length ? sp.product_ids.length + ' ebook(s)' : t('promo_all_ebooks') %><% if (promoCodes(sp)) { %> · <%= t('promo_code') %> <strong><%= promoCodes(sp) %></strong><% } %><% if (sp.ends_at) { %> · <%= t('promo_until') %> <%= promoEnd(sp, lang) %><% } %></span>
    <a href="/ebooks" class="promo-bar-link"><%= t('promo_see') %> →</a>
  </div>
</div>
<% } %>
<main class="wrap">
