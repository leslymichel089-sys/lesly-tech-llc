<%- include('partials/header') %>

<% var withImg = products.filter(function (p) { return p.active && p.image; });
   var showcase = withImg.filter(function (p) { return p.type === 'ebook'; }).concat(withImg.filter(function (p) { return p.type !== 'ebook'; })).slice(0, 3); %>
<section class="hero reveal<%= showcase.length ? ' hero-split' : '' %>">
  <div class="hero-text">
    <span class="hero-badge"><%= t('hero_badge') %></span>
    <h1 class="hero-title"><%- t('welcome_title').replace('Lesly Tech LLC', '<span class="hl">Lesly Tech LLC</span>') %></h1>
    <p class="hero-tagline"><%= t('welcome_subtitle') %></p>
    <p class="hero-sub"><%= t('home_intro_text') %></p>
    <div class="hero-ctas">
      <a class="btn" href="/catalogue"><%= t('cta_catalogue') %> →</a>
      <a class="btn btn-ghost" href="/ebooks"><%= t('ebooks_cta') %></a>
    </div>
  </div>
  <% if (showcase.length) { %>
    <div class="hero-showcase" aria-hidden="true">
      <% showcase.forEach(function (p, i) { %>
        <a class="showcase-item showcase-<%= i + 1 %>" href="/produit/<%= p.id %>" tabindex="-1">
          <img src="<%= p.image %>" alt="" loading="eager">
        </a>
      <% }) %>
    </div>
  <% } %>
</section>

<% var activeProducts = products.filter(function (p) { return p.active; }); %>
<section class="stats-strip reveal">
  <div class="stat-card"><b><%= activeProducts.length %></b><span><%= t('stat_products') %></span></div>
  <div class="stat-card"><b><%= activeProducts.filter(function (p) { return p.type === 'ebook'; }).length %></b><span><%= t('stat_ebooks') %></span></div>
  <div class="stat-card"><b><%= activeProducts.filter(function (p) { return p.type === 'app'; }).length %></b><span><%= t('type_app') %></span></div>
  <div class="stat-card"><b>4</b><span><%= t('stat_langs') %></span></div>
</section>

<section class="section reveal">
  <span class="eyebrow"><%= t('home_intro_title') %></span>
  <h2 class="sec-title"><%= t('home_creations_title') %></h2>
  <div class="section-head">
    <p class="muted"><%= t('home_creations_sub') %></p>
    <a class="btn btn-small" href="/catalogue"><%= t('cta_catalogue') %></a>
  </div>
  <div class="grid">
    <% products.filter(p => p.active).slice(0, 6).forEach(function(p){ %>
      <%- include('partials/product_card', { p: p }) %>
    <% }) %>
  </div>
</section>

<%- include('partials/gift_form', { giftFrom: 'home' }) %>

<section class="band reveal">
  <img class="band-logo" src="/img/levent-logo.jpg" alt="Les Éditions LeVent" width="96" height="96">
  <h2><%= t('home_ebooks_title') %></h2>
  <p><%= t('home_ebooks_text') %></p>
  <a class="btn btn-light" href="/ebooks"><%= t('home_ebooks_cta') %></a>
  <p class="band-mail"><a href="mailto:<%= publisherEmail %>"><%= publisherEmail %></a></p>
</section>

<%- include('partials/footer') %>
