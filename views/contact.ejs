<%- include('partials/header') %>

<section class="page-head">
  <h1><%= t('contact_title') %></h1>
  <p class="muted"><%= t('contact_intro') %></p>
</section>

<% if (status === 'sent') { %><p class="alert alert-ok" role="status"><%= t('contact_status_sent') %></p><% } %>
<% if (status === 'invalid') { %><p class="alert alert-error" role="alert"><%= t('contact_status_invalid') %></p><% } %>
<% if (status === 'limited') { %><p class="alert alert-error" role="alert"><%= t('contact_status_limited') %></p><% } %>

<section class="dash-panel">
  <div class="contact-grid">
    <div>
      <h2><%= t('contact_address_label') %></h2>
      <p>Lesly Tech LLC<br>High Point, NC<br>USA</p>
    </div>
    <div>
      <h2><%= t('contact_email_label') %></h2>
      <p><a href="mailto:<%= contactEmail %>"><%= contactEmail %></a></p>
    </div>
  </div>
</section>

<section class="dash-panel">
  <div class="publisher-card">
    <img src="/img/levent-logo.jpg" alt="Les Éditions LeVent" width="84" height="84">
    <div>
      <h2 style="margin-bottom:6px">Les Éditions LeVent</h2>
      <p style="margin:0"><a href="mailto:<%= publisherEmail %>"><%= publisherEmail %></a></p>
    </div>
  </div>
</section>

<section class="dash-panel">
  <h2><%= t('contact_form_title') %></h2>
  <form method="post" action="/contact" class="form form-wide">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%# Champ piège anti-robots : invisible pour les humains, laissé vide. %>
    <div style="position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    </div>
    <div class="form-row">
      <label><%= t('contact_form_name') %>
        <input type="text" name="name" autocomplete="name" required maxlength="100" value="<%= form.name || '' %>"></label>
      <label><%= t('contact_form_email') %>
        <input type="email" name="email" autocomplete="email" required maxlength="200" value="<%= form.email || '' %>"></label>
    </div>
    <label><%= t('contact_form_message') %>
      <textarea name="message" rows="5" required maxlength="5000"><%= form.message || '' %></textarea></label>
    <p class="muted small"><%= t('contact_form_note') %></p>
    <div><button class="btn" type="submit"><%= t('contact_form_submit') %></button></div>
  </form>
</section>

<%- include('partials/footer') %>
