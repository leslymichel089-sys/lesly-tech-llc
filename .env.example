# Copiez ce fichier en .env et adaptez les valeurs. Ne commitez JAMAIS le .env.
PORT=3000
SITE_URL=http://localhost:3000
SESSION_SECRET=
DB_PATH=./data/site.db

# --- IA : OmniRoute (routeur avec fallback automatique intégré) ---
# Lancez OmniRoute sur le PC (omniroute.ps1) : il écoute sur http://localhost:20128/v1
# et fait lui-même la bascule entre 352 providers. Aucune clé requise pour les tiers gratuits.
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto
OMNIROUTE_API_KEY=
AI_TIMEOUT_MS=60000

# --- Fournisseurs directs par défaut : DeepSeek d'abord, Kimi ensuite ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6
# --- Secours : providers génériques (optionnel), tentés si OmniRoute est injoignable ---
AI_PROVIDER_1_URL=
AI_PROVIDER_1_KEY=
AI_PROVIDER_1_MODEL=
AI_PROVIDER_2_URL=
AI_PROVIDER_2_KEY=
AI_PROVIDER_2_MODEL=

# --- Notifications / watchdog (optionnel) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIF_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_MODE=callmebot
CALLMEBOT_APIKEY=
WHATSAPP_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TO=
WINDOWS_NOTIFY=
